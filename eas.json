{
  "cli": {
    "version": ">= 18.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "channel": "production"
    },
    "ios-production": {
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote"
      },
      "channel": "production"
    }
  }
}
